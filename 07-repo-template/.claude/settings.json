{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(python3 -m py_compile*)",
      "Bash(ls*)",
      "Bash(find . *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- Claude finished ---' && git diff --name-only HEAD 2>/dev/null && echo '(run: git diff to see full changes)'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Claude is waiting for your input]'"
          }
        ]
      }
    ]
  }
}
